# ─── LLM Server ───────────────────────────────────────────────────────────────
# Credenciales del servidor LLM (LM Studio o compatible OpenAI)
LLM_USER=tu_usuario
LLM_PASSWORD=tu_contraseña
LLM_BASE_URL=https://tu-servidor.ejemplo.mx/lmstudio/v1/
LLM_MODEL=openai/nombre-del-modelo
EMBEDDING_MODEL=text-embedding-nombre-del-modelo

# Correo para polite pool de OpenAlex (evita rate limiting)
EMAIL_ADDRESS=tu_correo@institucion.mx
# API Key opcional de OpenAlex (mejora límites)
OPENALEX_API_KEY=tu_api_key_openalex

# ─── ClickHouse REMOTO (OpenAlex bulk: works_flat, works_academic_all) ─────────
CH_HOST=ip.del.servidor.clickhouse
CH_PORT=8124
CH_USER=tu_usuario_ch
CH_PASSWORD=tu_contraseña_ch
CH_DATABASE=rag

# ─── ClickHouse LOCAL (dump ORCID) ────────────────────────────────────────────
CH_ORCID_HOST=127.0.0.1
CH_ORCID_PORT=8123
CH_ORCID_USER=admin
CH_ORCID_PASSWORD=tu_contraseña_orcid
CH_ORCID_DATABASE=orcid

# ─── OpenAlex API Local (opcional, evita rate limits de la API oficial) ────────
# Requiere tener corriendo el servidor local de OpenAlex
OPENALEX_LOCAL_API=http://localhost:5012

# ─── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_PASS=tu_contraseña_neo4j

# Neo4j instancia principal
NEO4J_URI_MEXICO=bolt://localhost:7688
NEO4J_USER_MEXICO=neo4j
NEO4J_PASSWORD_MEXICO=tu_contraseña_neo4j
